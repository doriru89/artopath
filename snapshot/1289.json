n_collection":null},{"id":"aw37","title_display":"Thirty-six Views of Mount Fuji","title":"Thirty-six Views of Mount Fuji","title_original":"","work_type":"painting","year":null,"country":"","node_type":"work","is_center":false,"primary_image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Red_Fuji_southern_wind_clear_morning.jpg?width=500","image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Red_Fuji_southern_wind_clear_morning.jpg?width=500","person_roles":[],"in_collection":null},{"id":"aw49","title_display":"The Dogana and Santa Maria della Salute, Venice","title":"The Dogana and Santa Maria della Salute, Venice","title_original":"","work_type":"painting","year":null,"country":"","node_type":"work","is_center":false,"primary_image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/The_Dogana_and_Santa_Maria_della_Salute%2C_Venice_E10742.jpg?width=500","image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/The_Dogana_and_Santa_Maria_della_Salute%2C_Venice_E10742.jpg?width=500","person_roles":[],"in_collection":null},{"id":"aw50","title_display":"Nocturne: Blue and Gold – Old Battersea Bridge","title":"Nocturne: Blue and Gold – Old Battersea Bridge","title_original":"","work_type":"painting","year":null,"country":"","node_type":"work","is_center":false,"primary_image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/James_Abbot_McNeill_Whistler_006.jpg?width=500","image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/James_Abbot_McNeill_Whistler_006.jpg?width=500","person_roles":[{"person_id":"ap389","person_name":"Aglaia Coronio","role_type":"collaborator","role_detail":"Collector"},{"person_id":"ap390","person_name":"Henry Greaves","role_type":"subject","role_detail":"Subject"},{"person_id":"ap344","person_name":"Frederick Richards Leyland","role_type":"patron","role_detail":"Patron"},{"person_id":"ap343","person_name":"John Ruskin","role_type":"critic","role_detail":"Critic"},{"person_id":"ap342","person_name":"James Abbott McNeill Whistler","role_type":"artist","role_detail":"Artist"}],"in_collection":null}],"edges":[{"source":"aw12","target":"aw41","type":"influenced","label":"Influenced","note":"Monet's late paintings, where forms dissolve into shimmering fields of color, are often cited as precursors to Abstract Expressionism. Rothko's large canvases, which use color to evoke profound emotional and spiritual states, can be seen as a conceptual extension of Monet's late-career focus on pure chromatic and light effects.","direction":"outgoing"},{"source":"aw12","target":"aw51","type":"influenced","label":"Influenced","note":"While created slightly before, Monet's late works, including the Venice series, pushed color into expressive, non-naturalistic realms that were central to the Fauvist movement, of which Derain was a key figure. Both artists used color to build form and convey emotion, liberating it from purely descriptive duty.","direction":"outgoing"},{"source":"aw12","target":"aw37","type":"inspired_by","label":"Inspired By","note":"Like many Impressionists, Monet was influenced by Japanese Ukiyo-e prints. Hokusai's series, depicting a single subject under various conditions, provided a conceptual model for Monet's own serial paintings, including his views of San Giorgio Maggiore.","direction":"outgoing"},{"source":"aw12","target":"aw49","type":"inspired_by","label":"Inspired By","note":"Monet greatly admired Turner's atmospheric depictions of Venice. Turner's focus on dissolving form into light and color, particularly over water, is a direct precedent for Monet's approach in his own Venetian series.","direction":"outgoing"},{"source":"aw12","target":"aw50","type":"inspired_by","label":"Inspired By","note":"Whistler's 'Nocturnes' explored tonal harmonies and capturing twilight moods, prioritizing atmosphere over detail. Monet's choice to paint San Giorgio Maggiore at dusk echoes Whistler's aesthetic of capturing the ephemeral moments between day and night.","direction":"outgoing"}],"lineage":{"influenced_by":["aw12","aw12","aw12","aw12","aw12"],"influences":[]},"stats":{"total_connected":5,"influences_count":3,"influenced_count":2,"filter":"all","vault_count":0,"beyond_count":5}}