on_id":"ap188","person_name":"Yasuyoshi Tokuma","role_type":"producer","role_detail":"Executive Producer"}],"in_collection":null},{"id":"aw252","title_display":"How Do You Live?","title":"How Do You Live?","title_original":"","work_type":"film","year":1937,"country":"","node_type":"work","is_center":false,"primary_image_url":null,"image_url":null,"person_roles":[],"in_collection":null},{"id":"aw282","title_display":"Isle of the Dead","title":"Isle of the Dead","title_original":"","work_type":"film","year":1883,"country":"","node_type":"work","is_center":false,"primary_image_url":null,"image_url":null,"person_roles":[{"person_id":"ap371","person_name":"Arnold Böcklin","role_type":"director","role_detail":""}],"in_collection":null},{"id":"aw284","title_display":"The King and the Mockingbird (Film)","title":"The King and the Mockingbird (Film)","title_original":"","work_type":"animation","year":1980,"country":"","node_type":"work","is_center":false,"primary_image_url":null,"image_url":null,"person_roles":[{"person_id":"ap156","person_name":"Paul Grimault","role_type":"director","role_detail":""}],"in_collection":null}],"edges":[{"source":"aw215","target":"aw285","type":"influenced","label":"Influenced","note":"By winning major international awards, including the Oscar for Best Animated Feature, the film has demonstrated the continued critical and commercial viability of large-scale, traditionally animated films, likely encouraging future investment in the medium.","direction":"outgoing"},{"source":"aw215","target":"aw286","type":"influenced","label":"Influenced","note":"Its radical 'no-marketing' approach in Japan, which generated immense organic buzz, has become a significant case study, potentially influencing campaigns for future films from highly established and anticipated directors.","direction":"outgoing"},{"source":"aw215","target":"aw11","type":"inspired_by","label":"Inspired By","note":"The film revisits and re-examines themes from Miyazaki's own earlier work, particularly the narrative of a child protagonist entering a perilous, magical world to rescue a family member and undergoing a profound personal transformation.","direction":"outgoing"},{"source":"aw215","target":"aw252","type":"inspired_by","label":"Inspired By","note":"While not a direct adaptation, the novel provides the film's Japanese title and core philosophical question. A copy of the book itself appears in the film as a pivotal gift to the protagonist from his late mother.","direction":"outgoing"},{"source":"aw215","target":"aw282","type":"inspired_by","label":"Inspired By","note":"The film's otherworldly island, with its stone structures and solemn atmosphere, strongly evokes the composition and Symbolist mood of Böcklin's iconic painting, suggesting a visual and thematic touchstone for the afterlife.","direction":"outgoing"},{"source":"aw215","target":"aw284","type":"inspired_by","label":"Inspired By","note":"A foundational film for Studio Ghibli, its depiction of vast, towering architecture and a world separated from reality is a clear aesthetic ancestor to the mysterious tower that serves as the gateway in 'The Boy and the Heron'.","direction":"outgoing"}],"lineage":{"influenced_by":["aw215","aw215","aw215","aw215","aw215","aw215"],"influences":[]},"stats":{"total_connected":6,"influences_count":4,"influenced_count":2,"filter":"all","vault_count":0,"beyond_count":6}}