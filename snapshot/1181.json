s_center":false,"primary_image_url":null,"image_url":null,"person_roles":[{"person_id":"ap356","person_name":"Gustave Courbet","role_type":"artist","role_detail":""}],"in_collection":null},{"id":"aw263","title_display":"Dutch Marine Painting (17th Century)","title":"Dutch Marine Painting (17th Century)","title_original":"","work_type":"painting","year":1650,"country":"","node_type":"work","is_center":false,"primary_image_url":null,"image_url":null,"person_roles":[{"person_id":"ap357","person_name":"Various Dutch Masters","role_type":"artist","role_detail":""}],"in_collection":null},{"id":"aw293","title_display":"The Forest of Fontainebleau","title":"The Forest of Fontainebleau","title_original":"","work_type":"painting","year":1846,"country":"","node_type":"work","is_center":false,"primary_image_url":null,"image_url":null,"person_roles":[{"person_id":"ap350","person_name":"Jean-Baptiste-Camille Corot","role_type":"artist","role_detail":""}],"in_collection":null},{"id":"aw6","title_display":"Rouen Cathedral","title":"Rouen Cathedral","title_original":"Rouen Cathedral","work_type":"painting","year":1892,"country":"","node_type":"work","is_center":false,"primary_image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Rouen_Cathedrale_Monet_Belgrade_W1329.jpg?width=400","image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Rouen_Cathedrale_Monet_Belgrade_W1329.jpg?width=400","person_roles":[{"person_id":"ap6","person_name":"Claude Monet","role_type":"artist","role_detail":"Artist"}],"in_collection":null},{"id":"aw5","title_display":"Impression, Sunrise","title":"Impression, Sunrise","title_original":"Impression, Sunrise","work_type":"painting","year":1872,"country":"France","node_type":"work","is_center":false,"primary_image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Monet_-_Impression,_Sunrise.jpg?width=400","image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Monet_-_Impression,_Sunrise.jpg?width=400","person_roles":[{"person_id":"ap6","person_name":"Claude Monet","role_type":"artist","role_detail":"Artist"},{"person_id":"ap66","person_name":"Louis Leroy","role_type":"collaborator","role_detail":"Critic (inadvertent namer)"}],"in_collection":null},{"id":"aw10","title_display":"La Grenouillère","title":"La Grenouillère","title_original":"La Grenouillère","work_type":"painting","year":1869,"country":"","node_type":"work","is_center":false,"primary_image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Claude_Monet_La_Grenouillére.jpg?width=400","image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Claude_Monet_La_Grenouillére.jpg?width=400","person_roles":[{"person_id":"ap6","person_name":"Claude Monet","role_type":"artist","role_detail":"Artist"}],"in_collection":null}],"edges":[{"source":"aw22","target":"aw109","type":"influenced","label":"Influenced","note":"Boudin was Monet's first teacher and directly encouraged him to paint outdoors. Monet's paintings of the same subject clearly adopt Boudin's theme of bourgeois leisure and his focus on capturing light and atmosphere.","direction":"outgoing"},{"source":"aw22","target":"aw261","type":"influenced","label":"Influenced","note":"Boudin was Monet's first teacher, and his beach scenes directly inspired Monet to adopt both the subject of modern leisure and the practice of plein-air painting, which became foundational to Impressionism.","direction":"outgoing"},{"source":"aw22","target":"aw262","type":"influenced","label":"Influenced","note":"The tradition of depicting seaside leisure, pioneered by Boudin, became a popular theme for later movements, with its subject matter and focus on light echoed in the works of American Impressionists.","direction":"outgoing"},{"source":"aw22","target":"aw266","type":"influenced","label":"Influenced","note":"Manet's depictions of modern leisure, including his own beach scenes, share a thematic connection with Boudin's pioneering work in establishing the lives of the fashionable bourgeoisie as a valid subject for modern art.","direction":"outgoing"},{"source":"aw22","target":"aw277","type":"influenced","label":"Influenced","note":"Boudin's popularization of the beach scene as a subject for modern art is echoed in the work of later artists like Vallotton, who continued to explore the theme of social gatherings on the coast.","direction":"outgoing"},{"source":"aw22","target":"aw278","type":"influenced","label":"Influenced","note":"The theme of modern leisure by the sea, pioneered by Boudin, became a staple of Impressionism and is strongly echoed in the work of American Impressionist Mary Cassatt.","direction":"outgoing"},{"source":"aw22","target":"aw281","type":"influenced","label":"Influenced","note":"Boudin's success in establishing the seaside resort as a legitimate subject for modern painting is echoed in the work of his contemporaries, like Manet, who also explored themes of modern life and leisure by the sea.","direction":"outgoing"},{"source":"aw22","target":"aw294","type":"influenced","label":"Influenced","note":"Boudin's popularization of the seaside resort as a subject for modern painting is echoed in Manet's work, reflecting a shared avant-garde interest in depicting contemporary bourgeois life.","direction":"outgoing"},{"source":"aw22","target":"aw273","type":"inspired_by","label":"Inspired By","note":"Jongkind was a mentor to Boudin, and his innovative, sketch-like approach to capturing light and atmosphere in marine paintings was a direct and acknowledged influence on Boudin's own technique.","direction":"outgoing"},{"source":"aw22","target":"aw274","type":"inspired_by","label":"Inspired By","note":"Boudin's emphasis on vast, dramatic skies, which often dominate his beach scenes, draws from the tradition of 17th-century Dutch masters who perfected the art of depicting atmospheric effects over the sea.","direction":"outgoing"},{"source":"aw22","target":"aw275","type":"inspired_by","label":"Inspired By","note":"The Barbizon School's practice of painting landscapes directly from nature (en plein air) was foundational to Boudin's method of working outdoors to capture the fleeting effects of light and weather on the Normandy coast.","direction":"outgoing"},{"source":"aw22","target":"aw291","type":"inspired_by","label":"Inspired By","note":"Boudin's emphasis on vast, dramatic skies and atmospheric effects was heavily inspired by 17th-century Dutch landscape painters, who were masters of capturing light over a low horizon.","direction":"outgoing"},{"source":"aw22","target":"aw292","type":"inspired_by","label":"Inspired By","note":"Boudin considered Jongkind his master and was directly influenced by his free, sketchy brushwork and his ability to capture the fleeting effects of light on water, a technique central to the Trouville beach scenes.","direction":"outgoing"},{"source":"aw22","target":"aw258","type":"inspired_by","label":"Inspired By","note":"Boudin adopted the Barbizon School's practice of painting outdoors (en plein air) to directly capture the effects of light and atmosphere, a method central to his beach scenes.","direction":"outgoing"},{"source":"aw22","target":"aw259","type":"inspired_by","label":"Inspired By","note":"Boudin greatly admired 17th-century Dutch marine painters for their mastery of depicting expansive, cloud-filled skies, which became a signature element of his own coastal paintings.","direction":"outgoing"},{"source":"aw22","target":"aw260","type":"inspired_by","label":"Inspired By","note":"A close friend and mentor, Jongkind's free brushwork and innovative approach to capturing fleeting light on water directly influenced Boudin's technique and style during their time painting together.","direction":"outgoing"},{"source":"aw22","target":"aw279","type":"inspired_by","label":"Inspired By","note":"Jongkind was a direct mentor to Boudin, and his mastery of capturing the fleeting effects of light and atmosphere on water with loose, expressive brushwork profoundly shaped Boudin's own marine paintings.","direction":"outgoing"},{"source":"aw22","target":"aw280","type":"inspired_by","label":"Inspired By","note":"As a leader of the Realist movement, Courbet's insistence on depicting contemporary, everyday life validated the subject matter of artists like Boudin, who turned from historical themes to paint modern bourgeois leisure.","direction":"outgoing"},{"source":"aw22","target":"aw263","type":"inspired_by","label":"Inspired By","note":"Boudin's emphasis on capturing atmospheric effects, vast skies, and light on water draws heavily from the tradition of 17th-century Dutch marine painters like Jacob van Ruisdael.","direction":"outgoing"},{"source":"aw22","target":"aw293","type":"inspired_by","label":"Inspired By","note":"The Barbizon School's practice of painting outdoors (*en plein air*) to capture natural light directly influenced Boudin's method, which is evident in the spontaneous feel and atmospheric quality of his work.","direction":"outgoing"},{"source":"aw6","target":"aw22","type":"inspired_by","label":"Inspired By","note":"Boudin, Monet's early mentor, famously encouraged him to paint outdoors ('en plein air'), a practice fundamental to capturing the fleeting effects of light and weather seen in the Cathedral series.","direction":"incoming"},{"source":"aw5","target":"aw22","type":"inspired_by","label":"Inspired By","note":"Boudin was Monet's mentor who famously encouraged him to paint outdoors ('en plein air'). Boudin's focus on capturing natural light and skies on the Normandy coast directly shaped Monet's early development.","direction":"incoming"},{"source":"aw10","target":"aw22","type":"inspired_by","label":"Inspired By","note":"Monet's mentor, Boudin, taught him the value of painting outdoors ('en plein air') and capturing atmospheric effects, a direct methodological precursor to La Grenouillère.","direction":"incoming"}],"lineage":{"influenced_by":["aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22","aw22"],"influences":["aw22","aw22","aw22"]},"stats":{"total_connected":23,"influences_count":12,"influenced_count":11,"filter":"all","vault_count":0,"beyond_count":23}}