":"aw116","title_display":"My Neighbor Totoro","title":"My Neighbor Totoro","title_original":"となりのトトロ","work_type":"film","year":1988,"country":"Japan","node_type":"work","is_center":false,"primary_image_url":"https://upload.wikimedia.org/wikipedia/en/0/02/My_Neighbor_Totoro_-_Tonari_no_Totoro_%28Movie_Poster%29.jpg","image_url":"https://upload.wikimedia.org/wikipedia/en/0/02/My_Neighbor_Totoro_-_Tonari_no_Totoro_%28Movie_Poster%29.jpg","person_roles":[{"person_id":"ap151","person_name":"Noriko Hidaka","role_type":"actor","role_detail":"Voice Actor (Satsuki)"},{"person_id":"ap77","person_name":"Joe Hisaishi","role_type":"composer","role_detail":"Composer"},{"person_id":"ap76","person_name":"Hayao Miyazaki","role_type":"director","role_detail":"Director & Writer"},{"person_id":"ap79","person_name":"Kazuo Oga","role_type":"director","role_detail":"Art Director"},{"person_id":"ap152","person_name":"Chika Sakamoto","role_type":"actor","role_detail":"Voice Actor (Mei)"},{"person_id":"ap153","person_name":"Hitoshi Takagi","role_type":"actor","role_detail":"Voice Actor (Totoro)"},{"person_id":"ap124","person_name":"Isao Takahata","role_type":"producer","role_detail":"Producer"}],"in_collection":null},{"id":"aw171","title_display":"Anne of Green Gables (anime series)","title":"Anne of Green Gables (anime series)","title_original":"","work_type":"animation","year":null,"country":"","node_type":"work","is_center":false,"primary_image_url":null,"image_url":null,"person_roles":[],"in_collection":null},{"id":"aw173","title_display":"The Wonderful Adventures of Nils (anime series)","title":"The Wonderful Adventures of Nils (anime series)","title_original":"","work_type":"animation","year":null,"country":"","node_type":"work","is_center":false,"primary_image_url":null,"image_url":null,"person_roles":[],"in_collection":null}],"edges":[{"source":"aw169","target":"aw174","type":"influenced","label":"Influenced","note":"This Studio Ghibli film, written by Miyazaki, expands on Kiki's central theme of creative block. The protagonist Shizuku's struggle with self-doubt and the pressure to create is a direct thematic successor to Kiki's loss of magic.","direction":"outgoing"},{"source":"aw169","target":"aw176","type":"influenced","label":"Influenced","note":"The series follows an aspiring witch who struggles with her magical abilities and self-confidence. Its focus on the everyday trials and personal growth of a young witch, rather than epic battles, is thematically aligned with Kiki's journey.","direction":"outgoing"},{"source":"aw169","target":"aw116","type":"inspired_by","label":"Inspired By","note":"As Miyazaki's immediately preceding feature film, its gentle pacing, focus on the inner world of its young female protagonists, and low-stakes narrative directly informed the tone and character-driven approach of Kiki's Delivery Service.","direction":"outgoing"},{"source":"aw169","target":"aw171","type":"inspired_by","label":"Inspired By","note":"Hayao Miyazaki worked on scene design and layout for this series. The themes of a resilient, independent young girl moving to a new town and building a life for herself strongly prefigure Kiki's journey.","direction":"outgoing"},{"source":"aw169","target":"aw173","type":"inspired_by","label":"Inspired By","note":"Miyazaki drew storyboards for the first two episodes of this series, which involved extensive aerial travel across a European landscape. This experience likely provided a foundation for conceptualizing and animating Kiki's flight sequences.","direction":"outgoing"}],"lineage":{"influenced_by":["aw169","aw169","aw169","aw169","aw169"],"influences":[]},"stats":{"total_connected":5,"influences_count":3,"influenced_count":2,"filter":"all","vault_count":0,"beyond_count":5}}