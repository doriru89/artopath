e.tmdb.org/t/p/w185/l449YMnPI9TesjFydVwDsNtGo14.jpg","is_phantom":true,"is_enriched":false,"hop_distance":3},{"id":"person_ap368","original_id":"ap368","type":"person","label":"Paul Durand-Ruel","name_native":"","nationality":"","birth_year":null,"death_year":null,"image_url":"","is_phantom":true,"is_enriched":false,"hop_distance":3},{"id":"person_ap369","original_id":"ap369","type":"person","label":"The Parisian Bourgeoisie","name_native":"","nationality":"","birth_year":null,"death_year":null,"image_url":"","is_phantom":true,"is_enriched":false,"hop_distance":3},{"id":"person_ap370","original_id":"ap370","type":"person","label":"Parisian Bourgeoisie","name_native":"","nationality":"","birth_year":null,"death_year":null,"image_url":"","is_phantom":true,"is_enriched":false,"hop_distance":3},{"id":"person_ap65","original_id":"ap65","type":"person","label":"Georges Clemenceau","name_native":"","nationality":"","birth_year":null,"death_year":null,"image_url":"https://image.tmdb.org/t/p/w185/xLB1KKa3GfOChIgQMesNEFgDavQ.jpg","is_phantom":true,"is_enriched":false,"hop_distance":3}],"edges":[{"source":"work_aw355","target":"person_ap71","type":"work_person","role_type":"artist","role_detail":"Artist"},{"source":"work_aw355","target":"work_aw359","type":"work_work","relation_type":"influenced","relation_note":"The Starry Night's subjective interpretation of reality, intense emotionality, and non-naturalistic use of color profoundly influenced the development of Expressionism. Van Gogh's expressive brushwork and psychological depth became foundational for the movement."},{"source":"work_aw355","target":"work_aw360","type":"work_work","relation_type":"influenced","relation_note":"This animated feature film is a direct homage to Van Gogh, with every frame painted in his style, making 'The Starry Night' a central visual and thematic element. It directly reinterprets his aesthetic and narrative world."},{"source":"work_aw355","target":"work_aw361","type":"work_work","relation_type":"influenced","relation_note":"This episode of the popular science fiction series directly features Van Gogh and his painting 'The Starry Night' as a plot device and visual motif. It explores themes of mental health and artistic perception, echoing the painting's emotional depth."},{"source":"work_aw355","target":"work_aw356","type":"work_work","relation_type":"inspired_by","relation_note":"Van Gogh was deeply inspired by Japanese prints, incorporating their bold outlines, flattened perspectives, and vibrant color contrasts into his own style. This influence is evident in the dynamic compositions and expressive forms of 'The Starry Night'."},{"source":"work_aw355","target":"work_aw357","type":"work_work","relation_type":"inspired_by","relation_note":"While Van Gogh moved beyond Impressionism's optical realism, he adopted its focus on light, color, and capturing sensory experience directly. His use of vibrant, unmixed colors and visible brushstrokes has roots in Impressionist techniques."},{"source":"work_aw355","target":"work_aw358","type":"work_work","relation_type":"inspired_by","relation_note":"Van Gogh's deep connection to his Dutch heritage and the tradition of dramatic, atmospheric landscapes may have subtly influenced his approach to natural scenes. While stylistically distinct, the spiritual and emotional depth found in some earlier Dutch works resonates with 'The Starry Night'."},{"source":"person_ap71","target":"person_ap6","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: Impression, Sunrise → The Starry Night","confidence":"corroborated"},{"source":"person_ap6","target":"work_aw364","type":"person_work","role_type":"artist","role_detail":""},{"source":"person_ap6","target":"work_aw261","type":"person_work","role_type":"artist","role_detail":""},{"source":"person_ap6","target":"work_aw22","type":"person_work","role_type":"collaborator","role_detail":"Protégé"},{"source":"person_ap6","target":"work_aw110","type":"person_wo