es":[{"person_id":"ap6","person_name":"Claude Monet","role_type":"artist","role_detail":"Artist"},{"person_id":"ap66","person_name":"Louis Leroy","role_type":"collaborator","role_detail":"Critic (inadvertent namer)"}],"in_collection":null},{"id":"aw109","title_display":"On the Beach at Trouville","title":"On the Beach at Trouville","title_original":"Sur la plage de Trouville","work_type":"painting","year":1863,"country":"France","node_type":"work","is_center":false,"primary_image_url":"https://images.metmuseum.org/CRDImages/ep/original/DT1032.jpg","image_url":"https://images.metmuseum.org/CRDImages/ep/original/DT1032.jpg","person_roles":[{"person_id":"ap6","person_name":"Claude Monet","role_type":"collaborator","role_detail":"Student / Protege"},{"person_id":"ap64","person_name":"Eugene Boudin","role_type":"artist","role_detail":"Artist"}],"in_collection":null},{"id":"aw70","title_display":"South Wind, Clear Sky (from Thirty-six Views of Mount Fuji)","title":"South Wind, Clear Sky (from Thirty-six Views of Mount Fuji)","title_original":"","work_type":"painting","year":null,"country":"","node_type":"work","is_center":false,"primary_image_url":"https://images.metmuseum.org/CRDImages/as/original/DP141053.jpg","image_url":"https://images.metmuseum.org/CRDImages/as/original/DP141053.jpg","person_roles":[],"in_collection":null}],"edges":[{"source":"aw108","target":"aw110","type":"influenced","label":"Influenced","note":"Monet's late work-same commitment to capturing light, pushed toward abstraction","direction":"outgoing"},{"source":"aw108","target":"aw111","type":"influenced","label":"Influenced","note":"Blanche Hoschede Monet learned this plein air approach directly from her stepfather","direction":"outgoing"},{"source":"aw108","target":"aw72","type":"influenced","label":"Influenced","note":"Monet directly revisited this composition and theme eleven years later, creating a pair of paintings featuring his stepdaughter Suzanne Hoschedé in a similar pose, demonstrating the original's lasting importance to his artistic practice.","direction":"outgoing"},{"source":"aw108","target":"aw73","type":"influenced","label":"Influenced","note":"Sargent, who knew and admired Monet, painted numerous en plein air scenes. This work, with its figures in white dresses holding parasols in a sun-drenched field, strongly echoes the subject, light effects, and spontaneous feel of Monet's 1875 masterpiece.","direction":"outgoing"},{"source":"aw108","target":"aw71","type":"inspired_by","label":"Inspired By","note":"Courbet's Realist commitment to painting ordinary people in contemporary landscapes, without academic idealization, helped create the artistic climate that allowed Impressionists like Monet to elevate scenes of everyday life to the status of major artworks.","direction":"outgoing"},{"source":"aw108","target":"aw69","type":"inspired_by","label":"Inspired By","note":"Manet's depiction of a modern woman and child in an outdoor, everyday setting, shown at the first Impressionist exhibition in 1874, prefigured Monet's turn toward similar large-scale figurative scenes painted en plein air.","direction":"outgoing"},{"source":"aw108","target":"aw5","type":"inspired_by","label":"Inspired By","note":"Three years earlier-same artist, growing ambition","direction":"outgoing"},{"source":"aw108","target":"aw109","type":"inspired_by","label":"Inspired By","note":"Boudin taught Monet plein air painting as a teenager","direction":"outgoing"},{"source":"aw108","target":"aw70","type":"inspired_by","label":"Inspired By","note":"Like many Impressionists, Monet was influenced by Japanese ukiyo-e prints. The low horizon line, emphasis on atmosphere, and capturing of a specific moment in nature echo compositional and thematic elements found in works by artists like Hokusai.","direction":"outgoing"},{"source":"aw110","target":"aw108","type":"inspired_by","label":"Inspired By","note":"From capturing a moment to creating timeless immersion-Monet's arc","direction":"incoming"},{"source":"aw111","target":"aw108","type":"inspired_by","label":"Inspired By","note":"Monet painted this 10 years before training Blanche-she learned his plein air method firsthand","direction":"incoming"},{"source":"aw5","target":"aw108","type":"influenced","label":"Influenced","note":"Three years later-Monet applies same principles to figure painting","direction":"incoming"},{"source":"aw109","target":"aw108","type":"influenced","label":"Influenced","note":"Monet's plein air figure paintings owe everything to Boudin's mentorship","direction":"incoming"}],"lineage":{"influenced_by":["aw108","aw108","aw108","aw108","aw108","aw108","aw108","aw108","aw108"],"influences":["aw108","aw108","aw108","aw108"]},"stats":{"total_connected":9,"influences_count":5,"influenced_count":8,"filter":"all","vault_count":0,"beyond_count":9}}