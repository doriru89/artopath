IzY2IzODQtNThmMi00ZDE4LWI5YzAtNzNlZTM1ZjYyYjUyXkEyXkFqcGdeQXVyODEzNjM5OTQ@._V1_.jpg","image_url":"https://m.media-amazon.com/images/M/MV5BNGIzY2IzODQtNThmMi00ZDE4LWI5YzAtNzNlZTM1ZjYyYjUyXkEyXkFqcGdeQXVyODEzNjM5OTQ@._V1_.jpg","person_roles":[{"person_id":"ap283","person_name":"Gillian Anderson","role_type":"actor","role_detail":"Voice Actor (Moro, English)"},{"person_id":"ap278","person_name":"Billy Crudup","role_type":"actor","role_detail":"Voice Actor (Ashitaka, English)"},{"person_id":"ap280","person_name":"Claire Danes","role_type":"actor","role_detail":"Voice Actor (San, English)"},{"person_id":"ap77","person_name":"Joe Hisaishi","role_type":"composer","role_detail":"Composer"},{"person_id":"ap279","person_name":"Yuriko Ishida","role_type":"actor","role_detail":"Voice Actor (San, Japanese)"},{"person_id":"ap277","person_name":"Yōji Matsuda","role_type":"actor","role_detail":"Voice Actor (Ashitaka, Japanese)"},{"person_id":"ap76","person_name":"Hayao Miyazaki","role_type":"director","role_detail":"Director & Writer"},{"person_id":"ap78","person_name":"Toshio Suzuki","role_type":"producer","role_detail":"Producer"}],"in_collection":null}],"edges":[{"source":"aw11","target":"aw124","type":"influenced","label":"Influenced","note":"Shinkai's blockbuster blends modern Japanese life with Shinto-inspired folklore, body-swapping, and themes of memory and loss, building on the commercial and thematic success of Spirited Away.","direction":"outgoing"},{"source":"aw11","target":"aw136","type":"influenced","label":"Influenced","note":"The film features a curious young girl who passes through a tunnel into a parallel, fantastical world that is initially alluring but reveals a sinister underbelly, echoing Chihiro's journey.","direction":"outgoing"},{"source":"aw11","target":"aw138","type":"influenced","label":"Influenced","note":"Cartoon Saloon's film shares a Ghibli-esque reverence for nature, folklore, and a strong female protagonist who bridges the human and magical worlds, reflecting Spirited Away's thematic DNA.","direction":"outgoing"},{"source":"aw11","target":"aw123","type":"influenced","label":"Influenced","note":"Spirit world visuals and family memory themes - Pixar's Land of the Dead echoes bathhouse spirit realm","direction":"outgoing"},{"source":"aw11","target":"aw132","type":"inspired_by","label":"Inspired By","note":"Miyazaki frequently cites this as an influence for his heroines, particularly the theme of a young girl navigating a strange, logic-defying world and discovering her inner strength.","direction":"outgoing"},{"source":"aw11","target":"aw116","type":"inspired_by","label":"Inspired By","note":"Miyazaki's own prior work explores the interaction between children and the spirit world, establishing themes of nature spirits, childhood resilience, and maternal separation that are central to Spirited Away.","direction":"outgoing"},{"source":"aw11","target":"aw133","type":"inspired_by","label":"Inspired By","note":"Miyazaki worked as a key animator on this Toei Animation film, and its dynamic chase sequences and fluid character animation are foundational to the style later perfected at Studio Ghibli.","direction":"outgoing"},{"source":"aw215","target":"aw11","type":"inspired_by","label":"Inspired By","note":"The film revisits and re-examines themes from Miyazaki's own earlier work, particularly the narrative of a child protagonist entering a perilous, magical world to rescue a family member and undergoing a profound personal transformation.","direction":"incoming"},{"source":"aw123","target":"aw11","type":"inspired_by","label":"Inspired By","note":"Spirit world aesthetics, journey to understand family ancestry and memory","direction":"incoming"},{"source":"aw124","target":"aw11","type":"inspired_by","label":"Inspired By","note":"Supernatural Japanese coming-of-age","direction":"incoming"},{"source":"aw130","target":"aw11","type":"influenced","label":"Influenced","note":"The critical and commercial success of Mononoke's ambitious, mature storytelling directly enabled the production of Miyazaki's next film, which continued exploring the spirit world and environmental themes, leading to an Academy Award.","direction":"incoming"}],"lineage":{"influenced_by":["aw11","aw11","aw11","aw11","aw11","aw11","aw11"],"influences":["aw11","aw11","aw11","aw11"]},"stats":{"total_connected":9,"influences_count":3,"influenced_count":8,"filter":"all","vault_count":0,"beyond_count":9}}