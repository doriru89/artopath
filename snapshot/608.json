_distance":1,"person_roles":[{"person_id":"ap288","person_name":"James Cameron","role_type":"director","role_detail":"Director"}]},{"id":"work_aw267","original_id":"aw267","type":"work","label":"The Return of the King (novel)","title_display":"The Return of the King (novel)","title":"The Return of the King (novel)","title_original":"","work_type":"film","date_created_year":1955,"quality_tier":"skeleton","image_url":null,"primary_image_url":null,"is_phantom":true,"is_stub":true,"is_enriched":false,"hop_distance":1,"person_roles":[{"person_id":"ap161","person_name":"J.R.R. Tolkien","role_type":"director","role_detail":""}]},{"id":"work_aw269","original_id":"aw269","type":"work","label":"Middle-earth Illustrations","title_display":"Middle-earth Illustrations","title":"Middle-earth Illustrations","title_original":"","work_type":"film","date_created_year":1991,"quality_tier":"skeleton","image_url":null,"primary_image_url":null,"is_phantom":true,"is_stub":true,"is_enriched":false,"hop_distance":1,"person_roles":[{"person_id":"ap362","person_name":"Alan Lee & John Howe","role_type":"director","role_detail":""}]},{"id":"work_aw270","original_id":"aw270","type":"work","label":"Braveheart","title_display":"Braveheart","title":"Braveheart","title_original":"","work_type":"film","date_created_year":1995,"quality_tier":"skeleton","image_url":null,"primary_image_url":null,"is_phantom":true,"is_stub":true,"is_enriched":false,"hop_distance":1,"person_roles":[{"person_id":"ap363","person_name":"Mel Gibson","role_type":"director","role_detail":""}]},{"id":"work_aw268","original_id":"aw268","type":"work","label":"Ben-Hur","title_display":"Ben-Hur","title":"Ben-Hur","title_original":"","work_type":"film","date_created_year":1959,"quality_tier":"skeleton","image_url":null,"primary_image_url":null,"is_phantom":true,"is_stub":true,"is_enriched":false,"hop_distance":1,"person_roles":[{"person_id":"ap361","person_name":"William Wyler","role_type":"director","role_detail":""}]}],"edges":[{"source":"work_aw239","target":"work_aw271","type":"work_work","relation_type":"influenced","relation_note":"The film trilogy proved that epic, adult-oriented fantasy could achieve massive critical and commercial success, directly paving the way for the production scale, gritty realism, and narrative ambition of HBO's landmark series."},{"source":"work_aw239","target":"work_aw272","type":"work_work","relation_type":"influenced","relation_note":"The visual language and epic scope of modern fantasy video games were heavily shaped by Jackson's trilogy. Skyrim's vast landscapes, Norse-inspired architecture reminiscent of Rohan, and cinematic feel echo the aesthetic established by the films."},{"source":"work_aw239","target":"work_aw184","type":"work_work","relation_type":"influenced","relation_note":"The performance capture technology perfected by Weta Digital for the character of Gollum was a foundational technique expanded upon for the Na'vi in 'Avatar', setting a new standard for digitally-created, emotionally resonant characters."},{"source":"work_aw239","target":"work_aw267","type":"work_work","relation_type":"inspired_by","relation_note":"The film is a direct screen adaptation of the third and final volume of Tolkien's epic high-fantasy novel, 'The Lord of the Rings'."},{"source":"work_aw239","target":"work_aw269","type":"work_work","relation_type":"inspired_by","relation_note":"The entire visual aesthetic of the film, from the design of Minas Tirith to the armor of the Rohirrim, was directly based on the conceptual art of these two celebrated Tolkien illustrators, who were hired as lead concept artists for the trilogy."},{"source":"work_aw239","target":"work_aw270","type":"work_work","relation_type":"inspired_by","relation_note":"The visceral, chaotic, and ground-level perspective of the film's large-scale medieval battles, especially the Battle of the Pelennor Fields, draws stylistic inspiration from the gritty combat sequences popularized by 'Braveheart'."},{"source":"work_aw239","target":"work_aw268","type":"work_work","relation_type":"inspired_by","relation_note":"The film's monumental scale, vast battle sequences, and emotional weight are heavily inspired by classic Hollywood epics, with 'Ben-Hur' being a key touchstone. Both films share the record for most Academy Award wins (11)."}],"stats":{"total_nodes":8,"total_edges":7,"hop_0_count":1,"hop_1_count":7,"hop_2_count":0,"hop_3_count":0,"phantom_count":8,"vault_count":0}}