":"","nationality":"","birth_year":null,"death_year":null,"image_url":"","is_phantom":true,"is_enriched":false,"hop_distance":3},{"id":"person_ap370","original_id":"ap370","type":"person","label":"Parisian Bourgeoisie","name_native":"","nationality":"","birth_year":null,"death_year":null,"image_url":"","is_phantom":true,"is_enriched":false,"hop_distance":3},{"id":"person_ap65","original_id":"ap65","type":"person","label":"Georges Clemenceau","name_native":"","nationality":"","birth_year":null,"death_year":null,"image_url":"https://image.tmdb.org/t/p/w185/xLB1KKa3GfOChIgQMesNEFgDavQ.jpg","is_phantom":true,"is_enriched":false,"hop_distance":3}],"edges":[{"source":"work_aw8","target":"person_ap6","type":"work_person","role_type":"artist","role_detail":"Artist"},{"source":"work_aw8","target":"work_aw41","type":"work_work","relation_type":"influenced","relation_note":"The immersive, almost overwhelming color fields of Monet's late paintings are considered a key precursor to the color field painting movement. Rothko's work similarly uses vast expanses of color to evoke profound emotional and spiritual responses from the viewer."},{"source":"work_aw8","target":"work_aw55","type":"work_work","relation_type":"influenced","relation_note":"American Abstract Expressionist Joan Mitchell deeply admired Monet's late works. Her large-scale, gestural landscapes show a clear lineage in their approach to capturing the immersive, emotional experience of nature."},{"source":"work_aw8","target":"work_aw52","type":"work_work","relation_type":"inspired_by","relation_note":"Monet was an avid collector of Japanese ukiyo-e prints. The high-arched bridge motif, a central feature of his Giverny garden and this painting series, was directly inspired by prints like Hokusai's."},{"source":"work_aw8","target":"work_aw53","type":"work_work","relation_type":"inspired_by","relation_note":"Turner's late works, which dissolve form into tumultuous fields of light and color, are widely seen by art historians as a significant precedent for the abstraction Monet pursued in his own final years."},{"source":"work_aw8","target":"work_aw54","type":"work_work","relation_type":"inspired_by","relation_note":"This 1923 painting is a radical reinterpretation of a subject Monet himself painted over two decades earlier. The later version abandons representation in favor of capturing the raw sensation and memory of the scene."},{"source":"person_ap6","target":"person_ap64","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: Water Lilies (Grandes Decorations) → On the Beach at Trouville","confidence":"corroborated"},{"source":"person_ap6","target":"person_ap74","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: Water Lilies → The Great Wave off Kanagawa","confidence":"corroborated"},{"source":"person_ap71","target":"person_ap6","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: Impression, Sunrise → The Starry Night","confidence":"corroborated"},{"source":"person_ap67","target":"person_ap6","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: The Harvest → Water Lilies (Grandes Decorations)","confidence":"corroborated"},{"source":"person_ap6","target":"work_aw364","type":"person_work","role_type":"artist","role_detail":""},{"source":"person_ap6","target":"work_aw261","type":"person_work","role_type":"artist","role_detail":""},{"source":"person_ap6","target":"work_aw22","type":"person_work","role_type":"collaborator","role_detail":"Protégé"},{"source":"person_ap6","target":"work_aw110","type":"person_work","role_type":"artist","role_detail":"Artist"},{"source":"person_ap6","target":"work_aw2","type":"person_work","role_type":"artist","role_detail":"Artist"},{"source":"person_ap64","target":"work_aw109","type":"person_work","role_type":"artist","role_detail":"Artist"},{"source":"person_ap74","target":"work_aw23","type":"person_work","role_type":"artist","role_detail":