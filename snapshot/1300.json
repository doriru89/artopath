tury.jpg","is_phantom":true,"is_stub":false,"is_enriched":true,"hop_distance":2,"person_roles":[{"person_id":"ap74","person_name":"Katsushika Hokusai","role_type":"artist","role_detail":""}]},{"id":"work_aw355","original_id":"aw355","type":"work","label":"The Starry Night","title_display":"The Starry Night","title":"The Starry Night","title_original":"The Starry Night","work_type":"painting","date_created_year":1889,"quality_tier":"enriched","image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Van_Gogh_-_Starry_Night_-_Google_Art_Project.jpg?width=500","primary_image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Van_Gogh_-_Starry_Night_-_Google_Art_Project.jpg?width=500","is_phantom":true,"is_stub":false,"is_enriched":true,"hop_distance":2,"person_roles":[{"person_id":"ap71","person_name":"Vincent van Gogh","role_type":"artist","role_detail":"Artist"}]},{"id":"work_aw111","original_id":"aw111","type":"work","label":"The Harvest","title_display":"The Harvest","title":"The Harvest","title_original":"La Moisson","work_type":"painting","date_created_year":1890,"quality_tier":"enriched","image_url":"https://d7hftxdivxxvm.cloudfront.net/?height=603&quality=50&resize_to=fit&src=https%3A%2F%2Fd32dm0rphc51dk.cloudfront.net%2F8ey2uiurfigI0kXmkEfX-w%2Fmain.jpg&width=800","primary_image_url":"https://d7hftxdivxxvm.cloudfront.net/?height=603&quality=50&resize_to=fit&src=https%3A%2F%2Fd32dm0rphc51dk.cloudfront.net%2F8ey2uiurfigI0kXmkEfX-w%2Fmain.jpg&width=800","is_phantom":true,"is_stub":false,"is_enriched":true,"hop_distance":2,"person_roles":[{"person_id":"ap6","person_name":"Claude Monet","role_type":"collaborator","role_detail":"Stepfather / Teacher"},{"person_id":"ap67","person_name":"Blanche Hoschede Monet","role_type":"artist","role_detail":"Artist"}]},{"id":"person_ap65","original_id":"ap65","type":"person","label":"Georges Clemenceau","name_native":"","nationality":"","birth_year":null,"death_year":null,"image_url":"https://image.tmdb.org/t/p/w185/xLB1KKa3GfOChIgQMesNEFgDavQ.jpg","is_phantom":true,"is_enriched":false,"hop_distance":3}],"edges":[{"source":"work_aw6","target":"person_ap6","type":"work_person","role_type":"artist","role_detail":"Artist"},{"source":"work_aw6","target":"work_aw40","type":"work_work","relation_type":"influenced","relation_note":"Lichtenstein created a direct homage series, translating Monet's Impressionist brushstrokes into his signature Pop Art style using Ben-Day dots to explore mass reproduction and perception."},{"source":"work_aw6","target":"work_aw41","type":"work_work","relation_type":"influenced","relation_note":"Art historians connect Rothko's immersive fields of color to Monet's late series paintings. Both artists used seriality to explore the transcendent and emotional power of light and color, moving the subject away from representation towards pure sensation."},{"source":"work_aw6","target":"work_aw96","type":"work_work","relation_type":"influenced","relation_note":"Lichtenstein directly reinterpreted Monet's series through the lens of Pop Art and mechanical reproduction, using Ben-Day dots to explore how mass media processes perception, much as Monet explored how light does."},{"source":"work_aw6","target":"work_aw97","type":"work_work","relation_type":"influenced","relation_note":"Art historians widely see Monet's serial paintings as a precursor to the seriality in Pop Art. Warhol's repetition of a single motif explores themes of mass production, echoing Monet's study of subtle variation within a series."},{"source":"work_aw6","target":"work_aw22","type":"work_work","relation_type":"inspired_by","relation_note":"Boudin, Monet's early mentor, famously encouraged him to paint outdoors ('en plein air'), a practice fundamental to capturing the fleeting effects of light and weather seen in the Cathedral series."},{"source":"work_aw6","target":"work_aw93","type":"work_work","relation_type":"inspired_by","relation_note":"Hokusai's ukiyo-e print series, which depicted a single subject under various conditions, provided a direct conceptual model for Monet's serial approach to subjects like haystacks, poplars, and Rouen Cathedral."},{"source":"work_aw6","target":"work_aw94","type":"work_work","relation_type":"inspired_by","relation_note":"Muybridge's sequential photographs breaking down movement over time paralleled Monet's artistic project of capturing the changing appearance of a static object through the passage of light, making both artists pioneers in the study of temporality."},{"source":"work_aw6","target":"work_aw95","type":"work_work","relation_type":"inspired_by","relation_note":"The intricate, textured facade of the Gothic cathedral itself served as the foundational subject, providing a complex surface that fractured and reflected light in endlessly variable ways."},{"source":"work_aw6","target":"work_aw53","type":"work_work","relation_type":"inspired_by","relation_note":"Turner's dramatic use of light and atmosphere, often dissolving solid forms into color, was a profound influence on Monet's own explorations of optical phenomena over physical substance."},{"source":"work_aw6","target":"work_aw37","type":"work_work","relation_type":"inspired_by","relation_note":"Hokusai's series of woodblock prints, exploring a single subject under varying conditions, is widely cited by art historians as a key precedent for Monet's serial painting method."},{"source":"work_aw6","target":"work_aw38","type":"work_work","relation_type":"inspired_by","relation_note":"Turner's focus on dissolving form into light and atmosphere was a profound inspiration for the Impressionists, and Monet's Cathedral series takes this principle to an extreme."},{"source":"work_aw6","target":"work_aw39","type":"work_work","relation_type":"inspired_by","relation_note":"While stylistically opposite, Corot's traditional architectural portraits represent the established genre that Monet was subverting. Monet painted the *effect* of light on the cathedral, not the building itself."},{"source":"person_ap6","target":"person_ap64","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: Water Lilies (Grandes Decorations) → On the Beach at Trouville","confidence":"corroborated"},{"source":"person_ap6","target":"person_ap74","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: Water Lilies → The Great Wave off Kanagawa","confidence":"corroborated"},{"source":"person_ap71","target":"person_ap6","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: Impression, Sunrise → The Starry Night","confidence":"corroborated"},{"source":"person_ap67","target":"person_ap6","type":"person_person","relation_type":"influenced_by","relation_note":"Derived: The Harvest → Water Lilies (Grandes Decorations)","confidence":"corroborated"},{"source":"person_ap6","target":"work_aw364","type":"person_work","role_type":"artist","role_detail":""},{"source":"person_ap6","target":"work_aw261","type":"person_work","role_type":"artist","role_detail":""},{"source":"person_ap6","target":"work_aw22","type":"person_work","role_type":"collaborator","role_detail":"Protégé"},{"source":"person_ap6","target":"work_aw110","type":"person_work","role_type":"artist","role_detail":"Artist"},{"source":"person_ap6","target":"work_aw8","type":"person_work","role_type":"artist","role_detail":"Artist"},{"source":"person_ap64","target":"work_aw109","type":"person_work","role_type":"artist","role_detail":"Artist"},{"source":"person_ap74","target":"work_aw23","type":"person_work","role_type":"artist","role_detail":""},{"source":"person_ap71","target":"work_aw355","type":"person_work","role_type":"artist","role_detail":"Artist"},{"source":"person_ap67","target":"work_aw111","type":"person_work","role_type":"artist","role_detail":"Artist"},{"source":"work_aw364","target":"person_ap6","type":"work_person","role_type":"artist","role_detail":""},{"source":"work_aw261","target":"person_ap6","type":"work_person","role_