ear":1858,"quality_tier":"skeleton","image_url":null,"primary_image_url":null,"is_phantom":true,"is_stub":true,"is_enriched":false,"hop_distance":1,"person_roles":[{"person_id":"ap383","person_name":"Utagawa Hiroshige","role_type":"artist","role_detail":""}]},{"id":"work_aw299","original_id":"aw299","type":"work","label":"The works of Diego Velázquez","title_display":"The works of Diego Velázquez","title":"The works of Diego Velázquez","title_original":"","work_type":"painting","date_created_year":1656,"quality_tier":"skeleton","image_url":null,"primary_image_url":null,"is_phantom":true,"is_stub":true,"is_enriched":false,"hop_distance":1,"person_roles":[{"person_id":"ap384","person_name":"Diego Velázquez","role_type":"artist","role_detail":""}]},{"id":"work_aw303","original_id":"aw303","type":"work","label":"Early Nocturnal Photography","title_display":"Early Nocturnal Photography","title":"Early Nocturnal Photography","title_original":"","work_type":"painting","date_created_year":1860,"quality_tier":"skeleton","image_url":null,"primary_image_url":null,"is_phantom":true,"is_stub":true,"is_enriched":false,"hop_distance":1,"person_roles":[{"person_id":"ap387","person_name":"Various Pioneers","role_type":"artist","role_detail":""}]},{"id":"work_aw12","original_id":"aw12","type":"work","label":"San Giorgio Maggiore","title_display":"San Giorgio Maggiore","title":"San Giorgio Maggiore","title_original":"San Giorgio Maggiore","work_type":"painting","date_created_year":1908,"quality_tier":"enriched","image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Amgueddfa_Cymru_-_San_Giorgio_Maggiore_-_222942.jpeg?width=400","primary_image_url":"https://commons.wikimedia.org/wiki/Special:FilePath/Amgueddfa_Cymru_-_San_Giorgio_Maggiore_-_222942.jpeg?width=400","is_phantom":true,"is_stub":false,"is_enriched":true,"hop_distance":1,"person_roles":[{"person_id":"ap6","person_name":"Claude Monet","role_type":"artist","role_detail":"Artist"}]}],"edges":[{"source":"work_aw50","target":"person_ap342","type":"work_person","role_type":"artist","role_detail":"Artist"},{"source":"work_aw50","target":"person_ap343","type":"work_person","role_type":"critic","role_detail":"Critic"},{"source":"work_aw50","target":"person_ap344","type":"work_person","role_type":"patron","role_detail":"Patron"},{"source":"work_aw50","target":"person_ap389","type":"work_person","role_type":"collaborator","role_detail":"Collector"},{"source":"work_aw50","target":"person_ap390","type":"work_person","role_type":"subject","role_detail":"Subject"},{"source":"work_aw50","target":"work_aw290","type":"work_work","relation_type":"influenced","relation_note":"Whistler's famous defense of this painting as an 'arrangement of line, form and colour' was a foundational argument for abstraction, influencing artists like Kandinsky who sought to create non-representational art based on musical principles."},{"source":"work_aw50","target":"work_aw300","type":"work_work","relation_type":"influenced","relation_note":"The Belgian Symbolist's work shares a similar sense of quiet melancholy and simplified, dramatic composition, echoing Whistler's use of darkness and limited form to evoke emotion."},{"source":"work_aw50","target":"work_aw302","type":"work_work","relation_type":"influenced","relation_note":"American modernist John Marin's depictions of bridges often fracture the form into expressive lines, but the underlying interest in capturing an urban structure's atmospheric presence echoes Whistler's earlier focus on the Battersea Bridge."},{"source":"work_aw50","target":"work_aw249","type":"work_work","relation_type":"influenced","relation_note":"The Pictorialist photography movement, led by figures like Steichen, embraced the atmospheric, moody, and tonal qualities of Whistler's Nocturnes to elevate photography to a fine art."},{"source":"work_aw50","target":"work_aw304","type":"work_work","relation_type":"influenced","relation_note":"Steichen's Pictorialist photography directly embraced the Tonalist aesthetic pioneered by Whistler's Nocturnes, using soft focus and subtle gradations of light to create evocative, moody landscapes."},{"source":"work_aw50","target":"work_aw305","type":"work_work","relation_type":"influenced","relation_note":"Whistler's radical emphasis on color and form to evoke emotion is a clear precursor to Abstract Expressionism; Rothko's immersive color fields similarly prioritize emotional resonance over representation."},{"source":"work_aw50","target":"work_aw297","type":"work_work","relation_type":"influenced","relation_note":"Murakami's work of the same title is a direct contemporary homage, demonstrating the original painting's enduring legacy and its capacity for modern reinterpretation."},{"source":"work_aw50","target":"work_aw289","type":"work_work","relation_type":"influenced","relation_note":"The Pictorialist photography movement adopted Whistler's Tonalist aesthetic, creating soft-focus, atmospheric images like Steichen's that prioritized mood and painterly composition over documentary clarity."},{"source":"work_aw50","target":"work_aw246","type":"work_work","relation_type":"inspired_by","relation_note":"Whistler's asymmetrical composition, flattened perspective, and cropped forms are directly influenced by Japanese Ukiyo-e woodblock prints, particularly the bridge and firework scenes by Hiroshige."},{"source":"work_aw50","target":"work_aw288","type":"work_work","relation_type":"inspired_by","relation_note":"The painting is a primary example of the Aesthetic Movement's philosophy, prioritizing visual harmony and sensory experience over narrative or moral content, as reflected in its musical title."},{"source":"work_aw50","target":"work_aw295","type":"work_work","relation_type":"inspired_by","relation_note":"Whistler borrowed the musical term 'Nocturne' to title his paintings, emphasizing his focus on color harmony, mood, and abstract arrangement over literal depiction, aligning with the Aesthetic movement's 'art for art's sake' philosophy."},{"source":"work_aw50","target":"work_aw298","type":"work_work","relation_type":"inspired_by","relation_note":"Whistler directly borrowed compositional elements from Japanese Ukiyo-e woodblock prints, such as the high horizon, flattened perspective, and asymmetrical placement of the bridge."},{"source":"work_aw50","target":"work_aw299","type":"work_work","relation_type":"inspired_by","relation_note":"Whistler deeply admired Velázquez's masterful use of subtle tonal variations and limited color palettes, which influenced his own approach to creating harmonious 'arrangements' of color."},{"source":"work_aw50","target":"work_aw303","type":"work_work","relation_type":"inspired_by","relation_note":"The emerging art of photography, particularly its attempts to capture low-light scenes, influenced Whistler's exploration of monochromatic palettes and simplified forms to convey the ambience of the city at night."},{"source":"work_aw12","target":"work_aw50","type":"work_work","relation_type":"inspired_by","relation_note":"Whistler's 'Nocturnes' explored tonal harmonies and capturing twilight moods, prioritizing atmosphere over detail. Monet's choice to paint San Giorgio Maggiore at dusk echoes Whistler's aesthetic of capturing the ephemeral moments between day and night."}],"stats":{"total_nodes":21,"total_edges":20,"hop_0_count":1,"hop_1_count":20,"hop_2_count":0,"hop_3_count":0,"phantom_count":21,"vault_count":0}}